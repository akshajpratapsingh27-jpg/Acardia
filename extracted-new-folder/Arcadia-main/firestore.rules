rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(members) { return signedIn() && request.auth.uid in members; }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;

      match /friends/{friendId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update, delete: if signedIn() &&
          (request.auth.uid == userId || request.auth.uid == friendId);
      }
    }

    match /friendInvites/{inviteId} {
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string;
      allow read, update: if signedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /conversations/{conversationId} {
      allow create: if isMember(request.resource.data.members);
      allow read, update: if isMember(resource.data.members);
      match /messages/{messageId} {
        allow read: if isMember(get(/databases/$(database)/documents/conversations/$(conversationId)).data.members);
        allow create: if isMember(get(/databases/$(database)/documents/conversations/$(conversationId)).data.members)
          && request.resource.data.senderId == request.auth.uid;
      }
    }

    match /gameRooms/{roomId} {
      allow create: if isMember(request.resource.data.players);
      allow read, update: if isMember(resource.data.players);
    }
  }
}
